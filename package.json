{
  "name": "gaia-configurator",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "clients/*",
    "clients/web-react",
    "api"
  ],
  "scripts": {
    "start:mobile": "cd clients/mobile && npm start",
    "start:web": "cd clients/web && npm start",
    "dev:api": "cd api && npm run dev",
    "install:all": "npm install",
    "postinstall": "patch-package"
  },
  "devDependencies": {
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0"
  }
}
