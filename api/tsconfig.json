{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@gaia/shared": ["../packages/shared/src/index.ts"],
      "@gaia/shared/*": ["../packages/shared/src/*"]
    }
  },
  "include": ["party/**/*"],
  "exclude": ["node_modules", "dist"]
}

